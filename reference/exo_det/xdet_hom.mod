// varexo_det reference (dump_exo_det.m): homotopy on a varexo_det (oo_.exo_det_steady_state), save_params_and_steady_state, forecast
var y c k a i;
varexo e u;
varexo_det g tau;
parameters alpha beta delta rho;
alpha = 0.33; beta = 0.99; delta = 0.025; rho = 0.9;
model;
1/c = beta/c(+1)*((1-tau)*alpha*exp(a(+1))*k^(alpha-1) + 1 - delta);
y = exp(a)*k(-1)^alpha;
k = y - c - g*exp(u) + (1-delta)*k(-1);
a = rho*a(-1) + e;
i = k - (1-delta)*k(-1);
end;
initval;
k = 30; c = 2; y = 3; a = 0; i = 0.7; g = 0.1; tau = 0.05;
end;
steady;
homotopy_setup;
g, 0.1, 0.4;
end;
steady(homotopy_mode=1, homotopy_steps=5);
shocks;
var e; stderr 0.01;
var u; stderr 0.02;
var g; periods 1; values 0.45;
end;
save_params_and_steady_state('xdet_hom_ss.txt');
stoch_simul(order=1, irf=0, nograph);
forecast(periods=5);
