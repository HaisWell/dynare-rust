// varexo_det reference (dump_exo_det.m): estimation: constant of the state space; forecast=H with the deterministic path (the zeros make_ex_ leaves); shock_decomposition; conditional_forecast
var y c k a;
varexo e;
varexo_det g;
parameters alpha beta delta rho;
alpha = 0.33; beta = 0.99; delta = 0.025; rho = 0.9;
model;
1/c = beta/c(+1)*(alpha*exp(a(+1))*k^(alpha-1) + 1 - delta);
y = exp(a)*k(-1)^alpha;
k = y - c - g + (1-delta)*k(-1);
a = rho*a(-1) + e;
end;
initval;
k = 30; c = 2; y = 3; a = 0; g = 0.1;
end;
steady;
shocks;
var e; stderr 0.01;
var g; periods 1:2 4; values 0.15 0.2;
end;
varobs y;
estimated_params;
rho, 0.85, beta_pdf, 0.8, 0.1;
stderr e, 0.0104, inv_gamma_pdf, 0.01, inf;
end;
estimation(datafile='xdet_data.csv', mode_compute=0, mh_replic=0, smoother, forecast=8, nograph);
shock_decomposition(parameter_set=calibration) y;
conditional_forecast_paths;
var y;
periods 1:2;
values 3.05;
end;
conditional_forecast(parameter_set=calibration, controlled_varexo=(e), periods=6);
