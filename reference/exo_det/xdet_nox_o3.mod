// varexo_det reference (dump_exo_det.m): comparison case without varexo_det: forecast at order 3 with pruning
var y c k a;
varexo e;
parameters alpha beta delta rho;
alpha = 0.33; beta = 0.99; delta = 0.025; rho = 0.9;
model;
1/c = beta/c(+1)*(alpha*exp(a(+1))*k^(alpha-1) + 1 - delta);
y = exp(a)*k(-1)^alpha;
k = y - c - 0.1 + (1-delta)*k(-1);
a = rho*a(-1) + e;
end;
initval;
k = 30; c = 2; y = 3; a = 0;
end;
steady;
shocks;
var e; stderr 0.01;
end;
stoch_simul(order=3, pruning, irf=0, nograph);
forecast(periods=6);
