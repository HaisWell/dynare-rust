var c k z;
varexo x y w;
parameters alpha beta delta;
alpha = 0.33; beta = 0.99; delta = 0.025;
model;
1/c = beta/c(+1)*(alpha*exp(z(+1))*k^(alpha-1) + 1 - delta);
k = exp(z)*k(-1)^alpha + (1-delta)*k(-1) - c + w;
z = 0.5*z(-1) + x + y;
end;
initval;
k = 30; c = 2; z = 0; x = 0.01; y = 0; w = 0;
end;
steady;
shock_paths;
  var x;
  periods 1, 2:5, 6:end;
  values initval.x*1.05, self.x(-1)*1.05, self.x(-1);
  var y;
  periods 1:3, 7, end;
  values 0.01, self.x + init.y + 0.01*alpha, self.y(-1)*0.5 + 0.0001*init.k;
  exogenize c;
  periods 2, 4:5;
  values 1.6, initval.c*1.01;
  endogenize w;
end;
perfect_foresight_setup(periods = 50);
perfect_foresight_solver;
