var y c k i l w r z u pi rn;
varexo e eu;
parameters alpha beta delta rho psi phi theta kappa phipi;
alpha=0.33; beta=0.99; delta=0.025; rho=0.9; psi=1.5; phi=0.5; theta=0.75; kappa=0.1; phipi=1.5;
model;
1/c = beta/c(+1)*(r(+1)+1-delta);
psi*c/(1-l) = w;
y = exp(z)*k(-1)^alpha*l^(1-alpha);
w = (1-alpha)*y/l;
r = alpha*y/k(-1);
k = i + (1-delta)*k(-1);
y = c + i;
z = rho*z(-1) + e;
log(u) = 0.5*log(u(-1)) + eu;
pi = beta*pi(+1) + kappa*log(y) + log(u);
rn = phipi*pi + sqrt(exp(z)) + pi(-1)*0;
end;
initval;
y=1.2; c=0.9; k=12; i=0.3; l=0.33; w=2; r=0.035; z=0; u=1; pi=0; rn=0;
end;
steady;
shocks; var e; stderr 0.01; end;
stoch_simul(order=1, irf=0);
