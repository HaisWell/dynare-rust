var y1 y2;
varexo e1;
parameters a;
a = 0.5;
model;
y1 = a*y1(-1) + e1;
y2 = y1;
end;
varobs y1 y2;
svar_identification;
exclusion lag 0;
equation 2, y1;
exclusion lag 2;
equation 1, y2;
end;
markov_switching(chain=1, number_of_regimes=2, duration=4);
markov_switching(chain=2, number_of_regimes=2, duration=3);
svar(coefficients, equations=[1], chain=1);
svar(variances, chain=2);
ms_estimation(datafile=d2, freq=4, initial_year=1960, final_year=1988, nlags=2, specification=none, max_number_of_stages=0, convergence_starting_value=1e-5, convergence_ending_value=1e-7, number_of_large_perturbations=0, number_of_small_perturbations=0);
ms_compute_probabilities;
ms_compute_probabilities(filtered_probabilities);
