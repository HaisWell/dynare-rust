var y1 y2;
varexo e1;
parameters a;
a = 0.5;
model;
y1 = a*y1(-1) + e1;
y2 = y1;
end;
varobs y1 y2;
svar_identification;
upper_cholesky;
end;
markov_switching(chain=1, number_of_regimes=2, duration=4);
svar(variances, chain=1);
ms_estimation(datafile=d2, freq=4, initial_year=1960, final_year=1988, nlags=2, max_number_of_stages=0, convergence_starting_value=1e-5, convergence_ending_value=1e-7, number_of_large_perturbations=0, number_of_small_perturbations=0);
ms_irf(regimes, horizon=6, error_band_percentiles=[0.5]);
verbatim;
copyfile('m2/IRF','keep/c1');
end;
ms_irf(horizon=6, filtered_probabilities, error_band_percentiles=[0.16 0.5 0.84]);
verbatim;
copyfile('m2/IRF','keep/c2');
end;
ms_irf(horizon=6, error_band_percentiles=[0.5]);
verbatim;
copyfile('m2/IRF','keep/c3');
end;
ms_irf(horizon=6, regime=2, shock_draws=200, error_band_percentiles=[0.5]);
verbatim;
copyfile('m2/IRF','keep/c4');
end;
ms_variance_decomposition(regimes, horizon=6, no_error_bands);
verbatim;
copyfile('m2/Variance_Decomposition','keep/c5');
end;
ms_variance_decomposition(horizon=6, no_error_bands);
verbatim;
copyfile('m2/Variance_Decomposition','keep/c6');
end;
ms_variance_decomposition(horizon=6, filtered_probabilities, no_error_bands);
verbatim;
copyfile('m2/Variance_Decomposition','keep/c7');
end;
ms_forecast(regimes, horizon=4, error_band_percentiles=[0.5], data_obs_nbr=2);
verbatim;
copyfile('m2/Forecast','keep/c8');
end;
ms_forecast(horizon=4, error_band_percentiles=[0.5]);
verbatim;
copyfile('m2/Forecast','keep/c9');
end;
